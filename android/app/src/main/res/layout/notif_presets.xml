<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_presets"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:layout_marginTop="6dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/p30"
        style="@style/WidgetButton"
        android:background="@drawable/plate10"
        android:text="0:30" />

    <TextView
        android:id="@+id/p60"
        style="@style/WidgetButton"
        android:layout_marginStart="5dp"
        android:background="@drawable/plate15"
        android:text="1:00"
        android:textColor="@color/accent_ink" />

    <TextView
        android:id="@+id/p90"
        style="@style/WidgetButton"
        android:layout_marginStart="5dp"
        android:background="@drawable/plate20"
        android:text="1:30" />

    <TextView
        android:id="@+id/p120"
        style="@style/WidgetButton"
        android:layout_marginStart="5dp"
        android:background="@drawable/plate25"
        android:text="2:00" />

    <TextView
        android:id="@+id/p180"
        style="@style/WidgetButton"
        android:layout_marginStart="5dp"
        android:background="@drawable/plate5"
        android:text="3:00"
        android:textColor="@color/accent_ink" />
</LinearLayout>
