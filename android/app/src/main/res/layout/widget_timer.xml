<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/time_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Chronometer
                android:id="@+id/chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/fg"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="1:30"
                android:textColor="@color/fg"
                android:textSize="40sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready · 0 sets"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/row_controls"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_toggle"
            style="@style/WidgetButton"
            android:layout_weight="1.6"
            android:background="@drawable/btn_accent"
            android:text="@string/start"
            android:textColor="@color/accent_ink" />

        <TextView
            android:id="@+id/btn_plus"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_dark"
            android:text="@string/plus15" />

        <TextView
            android:id="@+id/btn_stop"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_dark"
            android:text="@string/stop" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/row_presets"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/p30"
            style="@style/WidgetButton"
            android:background="@drawable/plate10"
            android:text="0:30" />

        <TextView
            android:id="@+id/p60"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:background="@drawable/plate15"
            android:text="1:00"
            android:textColor="@color/accent_ink" />

        <TextView
            android:id="@+id/p90"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:background="@drawable/plate20"
            android:text="1:30" />

        <TextView
            android:id="@+id/p120"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:background="@drawable/plate25"
            android:text="2:00" />

        <TextView
            android:id="@+id/p180"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:background="@drawable/plate5"
            android:text="3:00"
            android:textColor="@color/accent_ink" />
    </LinearLayout>
</LinearLayout>
